{
  "name": "@easycompute/plugin-intelion",
  "version": "0.1.0",
  "description": "EasyCompute Provider Plugin for Intelion.cloud.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "easycompute",
    "intelion",
    "cloud",
    "gpu",
    "compute",
    "provider-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max19970/easy-compute.git",
    "directory": "plugins/intelion"
  },
  "homepage": "https://github.com/Max19970/easy-compute#readme",
  "bugs": {
    "url": "https://github.com/Max19970/easy-compute/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@easycompute/plugin-sdk",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pretypecheck": "npm run build --workspace=@easycompute/plugin-sdk",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@easycompute/plugin-sdk": "^0.1.0"
  }
}
