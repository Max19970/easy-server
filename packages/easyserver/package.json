{
  "name": "@easyai101/easyserver",
  "version": "0.2.3",
  "description": "Provider-independent CLI for acquiring, managing and locally accessing rented compute.",
  "license": "MIT",
  "type": "module",
  "exports": {},
  "keywords": [
    "easyserver",
    "cloud",
    "compute",
    "cli",
    "gpu",
    "remote-access",
    "provider-plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max19970/easy-server.git",
    "directory": "packages/easyserver"
  },
  "homepage": "https://github.com/Max19970/easy-server#readme",
  "bugs": {
    "url": "https://github.com/Max19970/easy-server/issues"
  },
  "bin": {
    "easyserver": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@easyai101/easyserver-plugin-sdk",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pretypecheck": "npm run build --workspace=@easyai101/easyserver-plugin-sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:compiled",
    "test:compiled": "node --test test/*.test.mjs",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@easyai101/easyserver-plugin-sdk": "^0.2.0",
    "@napi-rs/keyring": "1.3.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "semver": "7.7.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0"
  }
}
