{
  "name": "@easycompute/cli",
  "version": "0.1.0",
  "description": "Provider-independent CLI for acquiring, managing and locally accessing rented compute.",
  "license": "MIT",
  "type": "module",
  "exports": {},
  "keywords": [
    "cloud",
    "compute",
    "cli",
    "gpu",
    "remote-access",
    "provider-plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max19970/easy-compute.git",
    "directory": "packages/easycompute"
  },
  "homepage": "https://github.com/Max19970/easy-compute#readme",
  "bugs": {
    "url": "https://github.com/Max19970/easy-compute/issues"
  },
  "bin": {
    "easycompute": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@easycompute/plugin-sdk",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pretypecheck": "npm run build --workspace=@easycompute/plugin-sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@easycompute/plugin-sdk": "^0.1.0",
    "@napi-rs/keyring": "1.3.0",
    "semver": "7.7.2"
  }
}
