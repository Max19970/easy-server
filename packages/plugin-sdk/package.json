{
  "name": "@easyai101/easyserver-plugin-sdk",
  "version": "0.2.0",
  "description": "Public SDK for building EasyServer Provider Plugins.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "easyserver",
    "cloud",
    "compute",
    "plugin",
    "sdk",
    "provider-plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max19970/easy-server.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/Max19970/easy-server#readme",
  "bugs": {
    "url": "https://github.com/Max19970/easy-server/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "dependencies": {
    "@types/node": "24.13.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
